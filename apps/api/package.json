{
  "name": "@cms/api",
  "private": true,
  "version": "2.0.0-rc.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/lib/contract-amount-math.test.ts src/lib/contract-base-policy.test.ts src/lib/downstream-contract-math.test.ts src/lib/downstream-payment-math.test.ts src/lib/evidence-storage.test.ts src/lib/downstream-settlement-math.test.ts src/lib/business-party.test.ts src/lib/owner-settlement-math.test.ts src/lib/audit-log-csv.test.ts src/lib/csv-export.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.3",
    "@fastify/static": "8.2.0",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.1",
    "fastify": "5.5.0",
    "zod": "3.25.76",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
