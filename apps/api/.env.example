# Windows-native deployment: copy to apps/api/.env and edit the secrets.
# PostgreSQL must be installed and running as a Windows service before starting the API.
NODE_ENV=production

# 运行形态。standalone = 独立部署（web）；embedded = 嵌入宿主进程（桌面端）。
# 两者的差别是硬约束，不是建议：
#   standalone  PORT 必须 > 0（0 会被拒绝，否则反向代理无从配置），只接受 postgresql://
#   embedded    PORT 允许 0（系统分配空闲端口），允许后续接入 pglite:
# 详见 apps/api/src/platform/runtime-contract.ts
RUNTIME_MODE=standalone
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://cms_user:change-this-database-password@127.0.0.1:5432/cost_management?schema=public
# 仅桌面端使用：把实际监听的 host/port 写到此文件（JSON），供 Electron 主进程读取。
# 独立部署留空，不写任何文件。
MOHENG_READY_FILE=
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
# Public internet access mode: set the final HTTPS origin only after the reverse proxy/certificate are working.
# Example: PUBLIC_BASE_URL=https://cost.example.com
PUBLIC_BASE_URL=
# Only trust explicit proxy addresses (e.g. local Caddy). Never set this to * or true.
TRUST_PROXY=127.0.0.1,::1
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required when PUBLIC_BASE_URL is set; back it up securely because MFA secrets depend on it.
MFA_ENCRYPTION_KEY=
# Independent HMAC key for login rate-limit buckets; JWT_SECRET rotation must not reset existing blocks.
# In public mode this must be a distinct random 32-byte hex key.
LOGIN_ATTEMPT_HMAC_KEY=
# Leave empty for same-origin production. In development, set http://localhost:5173 if Vite is cross-origin.
CORS_ORIGIN=
SEED_ADMIN_NAME=系统管理员
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=false
# Change-evidence files are stored outside PostgreSQL. Use a dedicated, access-restricted directory and back it up with the database.
# Defaults to apps/api/data/evidence when the API is started from apps/api.
EVIDENCE_STORAGE_DIR=

# PostgreSQL-backed async jobs. The in-process worker coordinates across app replicas with row locks.
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_JOB_POLL_MS=1000
# Defaults to <apps/api working directory>/data/jobs; keep outside public web roots and restrict filesystem ACLs.
BACKGROUND_JOB_STORAGE_DIR=

# Third-party integration secrets use AES-256-GCM. Use a dedicated random 32-byte key; do not reuse JWT_SECRET/MFA_ENCRYPTION_KEY.
INTEGRATION_ENCRYPTION_KEY=
# AI provider API keys use their own AES-256-GCM key; do not reuse JWT/MFA/integration keys.
ASSISTANT_ENCRYPTION_KEY=
# Backups need pg_dump and a private absolute path; Windows example below.
BACKUP_DIR=C:/MohengBackups
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql
# Must refer to a separate, disposable database host and be named *_restore_test or *-restore_test.
# Restore checks compare PostgreSQL system identifiers; the connecting DB role needs read-only pg_monitor access.
RESTORE_TEST_DATABASE_URL=
