# Docker Compose is optional. Copy this file to .env only when choosing container deployment.
# Replace every example secret before exposing the system outside a trusted network.
POSTGRES_DB=cost_management
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
WEB_PORT=8080
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
SEED_ADMIN_NAME=系统管理员
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=true
# Docker Compose: evidence files persist in this named volume. Do not point to an ephemeral container path.
EVIDENCE_STORAGE_DIR=/app/apps/api/data/evidence

# PostgreSQL-backed async XLSX jobs. Keep the in-process worker by default.
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_JOB_POLL_MS=1000
BACKGROUND_JOB_STORAGE_DIR=/app/apps/api/data/jobs
# Set BACKGROUND_WORKER_ENABLED=false when running the optional Compose worker profile.

# Dedicated key for third-party integration credentials (different from JWT_SECRET and MFA_ENCRYPTION_KEY).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
# Only these explicit public HTTPS hosts may receive integration probes or JSON deliveries. Comma-separated; wildcard entries must start with *.
INTEGRATION_ALLOWED_HOSTS=api.partner.example.com,*.integration.partner.example.com
# Set to a private absolute directory outside all public/static web roots. Restrict ACLs to the API runtime identity and backup operators.
BACKUP_DIR=C:/MohengBackups
BACKUP_RETENTION_DAYS=30
# AES-256-GCM encryption keyring. Each key value must be 64 hex chars from 32 random bytes; retain older keys until all archives encrypted with them expire. Store as protected deployment secrets, not in source control.
BACKUP_ENCRYPTION_KEYS={"primary":"replace-with-64-hex-characters"}
BACKUP_ACTIVE_ENCRYPTION_KEY_ID=primary
# Connection used only for pg_dumpall --globals-only. It needs privileges sufficient to read PostgreSQL roles/global metadata; protect this credential like an administrative backup secret.
BACKUP_GLOBALS_DATABASE_URL=postgresql://backup_operator:change-this-password@127.0.0.1:5432/postgres?schema=public
PG_DUMPALL_PATH=pg_dumpall
CREATEDB_PATH=createdb
DROPDB_PATH=dropdb
# Required isolated restore-test database on a different PostgreSQL cluster before using restore drills.
# The DB role used by DATABASE_URL and this URL needs read-only pg_monitor access to compare cluster system identifiers.
# Example: postgresql://cms_user:change-this-database-password@restore-test:5432/cost_management_restore_test?schema=public
RESTORE_TEST_DATABASE_URL=

# Independent HMAC key for login rate-limit buckets; generate 32 random bytes as hex.
LOGIN_ATTEMPT_HMAC_KEY=

# Optional OpenAI-compatible endpoint for the read-only assistant PoC. Leave blank for the default endpoint.
# Keep ASSISTANT_POC_ENABLED=false except in an explicitly approved isolated test environment.
ASSISTANT_POC_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
ASSISTANT_POC_MODEL_ID=
ASSISTANT_CHECKPOINT_DATABASE_URL=
