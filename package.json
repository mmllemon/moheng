{
  "name": "moheng-construction-cost-management",
  "private": true,
  "version": "1.6.0-rc.1",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w @cms/api\" \"npm run dev -w @cms/web\"",
    "build": "npm run build -w @cms/api && npm run build -w @cms/web",
    "lint": "npm run lint -w @cms/api && npm run lint -w @cms/web",
    "db:generate": "npm run prisma:generate -w @cms/api",
    "db:migrate": "npm run prisma:migrate -w @cms/api",
    "db:deploy": "npm run prisma:deploy -w @cms/api",
    "db:seed": "npm run seed -w @cms/api",
    "test": "npm run test -w @cms/api",
    "validate:release-candidate": "node scripts/validate-release-candidate.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
