# Replace with a real DNS name that resolves to the public IP of this Windows host.
# Caddy obtains and renews the TLS certificate automatically; inbound TCP 80/443 must reach this host.
cost.example.com {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=15552000"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # API must remain bound to loopback. Never proxy PostgreSQL or expose port 3001 directly.
    reverse_proxy 127.0.0.1:3001
}
